{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "wiki-api",
      "image": "mmazurovsky/postraves-wiki-api",
      "hostname": "api",
      "essential": true
    },
    {
      "name": "nginx",
      "image": "mmazurovsky/postraves-nginx",
      "hostname": "nginx",
      "essential": true,
      "portMappings": [
        {
          "hostPost": 80,
          "containerPort": 80
        }
      ],
      "links": [
        "api"
      ]
    }
  ]
}